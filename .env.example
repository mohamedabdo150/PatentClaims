# Copy to .env and adjust. Never commit real keys.
# SHA-256 hex digest(s) of accepted API keys (generate: python -c "import hashlib;print(hashlib.sha256(b'KEY').hexdigest())")
PATENT__SECURITY__API_KEY_SHA256=["replace-with-64-hex-sha256-digest-of-your-api-key-000000000000000"]
# Optional overrides (PATENT__<SECTION>__<KEY>)
PATENT__PROCESSING__MAX_PROCESSING_SECONDS=1800
PATENT__OUTPUT__MAX_RESPONSE_SIZE_MB=100
PATENT__LOGGING__LEVEL=INFO
WORKERS=2
CPU_LIMIT=14
MEMORY_LIMIT=56g
HOST_PORT=8000
